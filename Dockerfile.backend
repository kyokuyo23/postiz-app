# Backend + orchestrator only (no Next.js frontend, no nginx).
# For small VPS deployments where the frontend is hosted elsewhere (e.g. Vercel).
# Build:  docker build -f Dockerfile.backend -t postiz-backend:local .
FROM node:22.20-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    g++ \
    make \
    python3 \
    bash \
    openssl \
    ca-certificates \
&& rm -rf /var/lib/apt/lists/*

RUN npm --no-update-notifier --no-fund --global install pnpm@10.6.1

# Affiliate promo videos: HyperFrames renders HTML to MP4 with Chromium + FFmpeg.
# One render at a time (~400 MB RAM while it runs).
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium \
    ffmpeg \
    fonts-dejavu-core \
    fonts-noto-color-emoji \
&& rm -rf /var/lib/apt/lists/*
RUN mkdir -p /opt/hyperframes && cd /opt/hyperframes \
 && npm init -y >/dev/null \
 && npm --no-update-notifier --no-fund install --omit=dev hyperframes@0.8.216
ENV HYPERFRAMES_HOME=/opt/hyperframes \
    HYPERFRAMES_BROWSER_PATH=/usr/bin/chromium \
    HYPERFRAMES_SKIP_SKILLS=1 \
    HYPERFRAMES_NO_TELEMETRY=1 \
    HYPERFRAMES_NO_UPDATE_CHECK=1 \
    PUPPETEER_SKIP_DOWNLOAD=1

WORKDIR /app
COPY . /app

RUN pnpm install --frozen-lockfile
# tsc needs ~3 GB here; on a 2 GB VPS this relies on swap (vps-setup.sh makes 6 GB)
RUN NODE_OPTIONS="--max-old-space-size=3584" pnpm run build:backend \
 && NODE_OPTIONS="--max-old-space-size=3584" pnpm run build:orchestrator

COPY var/docker/start-backend.sh /usr/local/bin/start-backend.sh
RUN chmod +x /usr/local/bin/start-backend.sh

EXPOSE 3000
CMD ["/usr/local/bin/start-backend.sh"]

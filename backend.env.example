# Copy to backend.env and fill in. Never commit backend.env.

# --- Domains ---
API_DOMAIN=api.distributor-yokomitsu.web.id
MAIN_URL=https://app.distributor-yokomitsu.web.id
FRONTEND_URL=https://app.distributor-yokomitsu.web.id
NEXT_PUBLIC_BACKEND_URL=https://api.distributor-yokomitsu.web.id/api

# --- Secrets (generate each with: openssl rand -hex 32) ---
JWT_SECRET=
POSTGRES_PASSWORD=
TEMPORAL_DB_PASSWORD=

# Set to true after you have created your own account
DISABLE_REGISTRATION=false

# --- Social apps (fill only the ones you use) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
# Only after Meta approved these permissions for your app:
# THREADS_COMMENT_INBOX=true
# THREADS_KEYWORD_SEARCH=true

# --- Optional hardening (see .env.example) ---
# SESSION_JWT_TTL=30d
# RESTRICT_PROVIDER_ACCOUNT_MUTATIONS=true

# --- AI (optional) -----------------------------------------------------------
# Claude powers the AI assistant, agent, generator and auto post when set.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OpenAI: image generation, or text too when no Anthropic key is set.
# OPENAI_API_KEY=
# Force a provider when both keys exist: anthropic | openai
# AI_PROVIDER=
